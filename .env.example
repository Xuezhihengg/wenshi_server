# Copy this file to .env and adjust the values for your environment.
# Never commit a real .env file.

APP_NAME=wenshi-server
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ----- PostgreSQL / Redis (local development) -----
# Docker Compose builds its own internal URLs from the POSTGRES_* values below,
# so these localhost URLs are only used when running uvicorn directly.
POSTGRES_USER=wenshi
POSTGRES_PASSWORD=wenshi
POSTGRES_DB=wenshi
DATABASE_URL=postgresql+asyncpg://wenshi:wenshi@localhost:5432/wenshi
REDIS_URL=redis://localhost:6379/0

# ----- Host port bindings (Docker Compose, dev only) -----
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
NGINX_HTTP_PORT=80

# ----- Frontend build args (Docker Compose passes these into Vite) -----
# Use "/" when the bundle should call the same origin through nginx.
ADMIN_VITE_API_BASE_URL=http://localhost:8000
PORTAL_VITE_API_BASE_URL=http://localhost:8000

# ----- Logging -----
LOG_DIR=data/logs
LOG_FILE=api.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=10

# ----- Auth / security (REQUIRED to change in production) -----
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_ISSUER=wenshi-server
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_USERNAME=admin@wenshi.local
ADMIN_PASSWORD=dev-only-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ----- Verification providers: mock | aliyun_sms | dypnsapi_sms | aliyun_dm -----
# "mock" returns the code in the API response and is for development only.
PHONE_VERIFICATION_PROVIDER=mock
EMAIL_VERIFICATION_PROVIDER=mock
PHONE_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5

# ----- Aliyun SMS / DirectMail (optional) -----
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_PHONE_AUTH_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=Wenshi
ALIYUN_DM_REPLY_TO_ADDRESS=false
ALIYUN_DM_SUBJECT=Wenshi login code

# ----- Public URLs / uploads -----
PUBLIC_BASE_URL=http://127.0.0.1:8000
UPLOAD_DIR=data/uploads
MAX_AVATAR_UPLOAD_BYTES=5242880

# ----- Apple Sign In -----
APPLE_CLIENT_ID=com.example.wenshi
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# ----- Google Sign In (create your own OAuth clients) -----
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ----- LLM provider (OpenAI-compatible) -----
LLM_PROVIDER=nvidia
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=30
LLM_RESPONSE_FORMAT_JSON=true
