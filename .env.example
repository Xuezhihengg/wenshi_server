APP_NAME=wenshi-server
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000

# ----- Postgres / Redis credentials (used by docker-compose) -----
POSTGRES_USER=wenshi
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=wenshi
DATABASE_URL=postgresql+asyncpg://wenshi:change-me-in-production@postgres:5432/wenshi
REDIS_URL=redis://redis:6379/0

# ----- Host port bindings (only effective in dev compose) -----
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
NGINX_HTTP_PORT=80

# ----- Frontend build args (compose passes these into Vite build) -----
# Use "/" so the bundle calls the same origin via nginx in production.
ADMIN_VITE_API_BASE_URL=/
PORTAL_VITE_API_BASE_URL=/

# ----- Logging -----
LOG_DIR=data/logs
LOG_FILE=api.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=10
JWT_SECRET=change-me-in-production
JWT_ISSUER=wenshi-server
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_USERNAME=admin@wenshi.local
ADMIN_PASSWORD=change-me-admin-password
CORS_ORIGINS=https://wenshi.xin,https://www.wenshi.xin
PHONE_VERIFICATION_PROVIDER=mock
EMAIL_VERIFICATION_PROVIDER=mock
PHONE_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_PHONE_AUTH_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=问事
ALIYUN_DM_REPLY_TO_ADDRESS=false
ALIYUN_DM_SUBJECT=问事登录验证码
PUBLIC_BASE_URL=https://wenshi.xin
UPLOAD_DIR=data/uploads
MAX_AVATAR_UPLOAD_BYTES=5242880
APPLE_CLIENT_ID=com.xuezhihengg.wenshi
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
LLM_PROVIDER=nvidia
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=30
LLM_RESPONSE_FORMAT_JSON=true
